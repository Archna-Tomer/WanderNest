<% layout("layouts/boilerplate") -%>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <h1>Details:</h1>

            </div>


            <div class="card col-6 offset-2 listing-card">
                <img src="<%=detail.image.url%>" class="card-img-top show-img col-6" alt="...">
                <div class="card-body">
                    <p class="card-text">
                      Owned by:  <%= detail.owner.username %>
                    <ul>
                        <li><b>
                                <%= detail.title %>
                            </b></li>
                        <li>
                            <%= detail.description %>
                        </li>
                        <li> &#8377; <%= detail.price.toLocaleString("en-IN") %>
                        </li>
                        <li>
                            <%=detail.location%>
                        </li>
                        <li>
                            <%=detail.country%>
                        </li>
                        <li>
                            <%= detail.category %>
                        </li>
                    </ul>

                    </p>
                </div>
             <%   if(currUser && detail.owner._id.equals(currUser._id)){ %>


                <div class="row">
                    <div class="col-2">
                        <form action="/listings/<%=detail._id%>/edit" method="get">
                            <button class="btn btn-primary">Edit</button>
                        </form>

                    </div>
                    <div class="col-2">
                        <form action="/listings/<%=detail._id%>/delete?_method=DELETE" method="post">
                            <button class="btn btn-dark add-btn">Delete</button>
                        </form>

                    </div>
                </div>
                <% } %>
            


            </div>
            <hr>
            <div class="col-8 offset-2">
               <% if(currUser){ %>
                <h4>Leave your feedback</h4>
                <form action="/listings/<%=detail._id%>/reviews" method="post" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                    <fieldset class="starability-slot">
                      
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                      </fieldset>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment:</label>
                        <textarea name="review[comment]" id="comment" cols="40" rows="3" class="form-control" placeholder="please provide some valuable comments" required></textarea>
                        <div class="invalid-feedback">please write some comments</div>
                    </div>
                    <button class="btn btn-outline-dark mb-3">Submit</button>
                </form>
                <% } %>
                <hr>
                <h4>All Reviews:</h4>
                
               <div class="row">
                <% for(review of detail.reviews) { %>
                    <div class="card col-5  ms-3 mb-3">
                        <div class="card-body">
                            <h5 class="card-title"> @ <%= review.author.username %>  </h5>
                            <p class="card-text"><%= review.comment %></p>
                            
                            <p class="starability-result card-text" data-rating="<%= review.rating %>">
                             
                            </p>
                           
                              
                        </div>
                        <form  method="post" action="/listings/<%= detail._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button>Delete</button>
                        </form>
                    </div>
                    

                    <% } %>
                </div>
               
                
            
               
            </div>

















            


        </div>

       
    </body>